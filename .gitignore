# Binaries
/bin/
/kbengine
*.exe

# goreleaser's output directory (a local `goreleaser build` writes here)
/dist/

# Test / coverage
*.out
coverage.*

# Go
/vendor/

# Frontend deps and build output. dist/ is a build artifact and is NOT
# committed: it has no correct side in a merge, so two branches touching the
# frontend conflicted on a file nobody edits by hand, and the only honest
# resolution was always "rebuild". Everything that ships a binary builds it
# first (Dockerfile stage, goreleaser hook, CI) — see CONTRIBUTING.md.
/frontend/node_modules/
/frontend/dist/

# Editor / OS
.DS_Store
.idea/
.vscode/

# Local KB data (engine is data-agnostic; never commit a personal KB)
/testdata/private/

# Terraform / OpenTofu. State carries every value the module produced, including
# what a real provider would return about the account; plan files carry the same.
# Neither belongs in a public repository. The lock file DOES belong — it pins the
# provider build the way package-lock.json pins npm.
.terraform/
*.tfstate
*.tfstate.*
tfplan
*.tfplan

# Побочный продукт запуска валидатора карт: python кэширует импорт validate.py.
__pycache__/
